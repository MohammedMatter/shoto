<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!--
      READ_MEDIA_VISUAL_USER_SELECTED is deliberately NOT declared.

      Declaring it makes Android 14+ offer "Select photos…" (partial access)
      in the permission dialog. Partial access is structurally useless here:
      it exposes only the handful of images the user hand-picked, so the
      "Screenshots" album SHOTO is built around simply isn't visible and the
      library comes back empty. Leaving it out gives the plain
      Allow / Don't allow choice, which is the only one this app can work
      with.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Needed to drive the vibrator directly (see HapticsChannel.kt). Flutter's
      built-in haptics need no permission, but they route through
      HapticFeedbackConstants, which many Android skins map to nothing at all —
      so the app appeared to have no haptics whatsoever on a device whose
      system haptics were on and at full strength.

      This is a normal (non-dangerous) permission: it is granted at install
      time and never prompts the user.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:label="SHOTO"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!--
            Sharing an image into SHOTO lands here, not in MainActivity.

            Its own task (taskAffinity="") and excludeFromRecents are what
            make it behave like a sheet rather than a second copy of the app:
            it appears over whatever the user was doing, saves, and is gone
            without ever leaving a SHOTO entry in the recents switcher.
        -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/ShareTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/ShareTheme" />
            <!--
                SEND and SEND_MULTIPLE both, so picking several screenshots
                in the gallery and sharing them lands here as one sheet.
                Android sends the two as different actions, and an app that
                only declares SEND simply does not appear in the share sheet
                once more than one image is selected.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Asks Play services to fetch the OCR model at install time rather
             than on the first scan, which is what makes an unbundled model
             tolerable: without it the first search a user ever runs is the
             one that waits for a download. See docs/decisions/ml-models.md. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!--
          **Firebase does not get to start itself**, even though `main` now
          initializes it deliberately.

          The SDK ships a ContentProvider that Android runs during process
          creation, before any app code. Left in, it runs on *every* process
          — including the share sheet, which has no account and no navigation
          and must not pay for an SDK it never calls — and it fails there and
          says so in the log, because this app has no google-services.json on
          purpose.

          `main` passes explicit options from firebase_options.dart before the
          router is built, which is the only initialization that should ever
          happen. See lib/main.dart for why the ordering is a constraint
          rather than a preference.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:exported="false"
            tools:node="remove" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
      Android 11+ hides other installed apps unless they are declared here.
      Without these, canLaunchUrl() reports false for perfectly working
      intents and the actionable-screenshot buttons all appear broken.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>