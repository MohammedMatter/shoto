<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch field, dark mode. `AppPalette.canvasDark`. Tracks the canvas:
         #1A1A1A -> #121212 -> #111213 when the ramp took its +2 cool bias.

         **Only colours and bools are qualified by `night` in this project,
         never styles.** Android ranks the `night` qualifier above `vNN`, so a
         `values-night/styles.xml` would beat a `values-v31/styles.xml` on any
         dark-mode phone running Android 12 or later and silently disable the
         platform splash attributes. There is no `values-v31` any more —
         `androidx.core:core-splashscreen` backports those attributes, so one
         unqualified style file serves every API level — but the rule stands for
         the next person who reaches for a qualifier: anything that has to vary
         by mode is a colour or a bool, referenced from the one style file. -->
    <color name="splash_background">#111213</color>
</resources>
