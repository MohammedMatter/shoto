<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings Android itself renders, outside any Flutter surface.

    The Quick Settings tile's label and the capture notification are both drawn
    by the system, sometimes before Shoto's process exists — so they cannot come
    from the ARB files like every other string in the app, and they follow the
    **device** language rather than the in-app language picker. That is correct
    for a system surface.

    `qs_tile_label` is deliberately identical to `quickSaveTitleOne`, the title
    of the sheet the tile opens. Two names for one action is how a user ends up
    unsure whether they are the same thing.
-->
<resources>
    <string name="qs_tile_label">Save to Shoto</string>
    <string name="capture_notice_title">Keep this screenshot?</string>
    <string name="capture_notice_body">Tap to file it in Shoto</string>
    <string name="capture_channel_name">New screenshots</string>
    <string name="capture_channel_description">Offers to file a screenshot the moment you take it</string>
    <!--
        The reminder channel's own name and description, but *not* the text of
        a reminder: that names the user's own verb ("Time to pay this") and is
        composed in Dart from the ARB files, then handed to the scheduler. So
        the notification itself follows the in-app language, and only the
        channel — which Android draws in its own settings screen, with no app
        running — follows the device.
    -->
    <string name="reminder_channel_name">Reminders</string>
    <string name="reminder_channel_description">Brings back a screenshot at the time you asked for</string>
</resources>
