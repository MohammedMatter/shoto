<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors AppPalette.light.background, which is AppPalette.canvasLight.
         The native splash must match the app's first painted frame exactly, or
         launching shows a flash of a different colour before Flutter takes
         over.

         This had drifted: it was #FAFAFA, which is AppPalette.paper — the
         value the canvas *used* to be, before the light canvas was dropped a
         step so a white card had somewhere to sit above it. Eleven values of
         off-white, on the first frame of every cold start. Worth re-checking
         here whenever a canvas moves; the mismatch is silent everywhere except
         on a real device at launch. -->
    <color name="splash_background">#F4F4F4</color>
</resources>
