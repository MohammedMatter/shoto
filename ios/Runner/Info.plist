<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Shoto needs access to your photo library to find and organize your screenshots.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Shoto needs permission to manage screenshots you delete from your library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Shoto uses Face ID to unlock your private folders.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Shoto</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>shoto</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!--
	  The companion to the portrait-only ~ipad list below, and it is required
	  rather than a preference: an iPad app that takes part in multitasking
	  must support all four orientations, so trimming that list without this
	  fails App Store validation with "All interface orientations must be
	  supported unless the app requires full screen." Slide Over and Split
	  View go with it, which is the honest consequence of an app that only
	  ever draws one way up.
	-->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!--
	  Portrait, and portrait is the whole list.

	  iOS reads this before any Dart runs, so it — not
	  SystemChrome.setPreferredOrientations — is what governs the launch
	  storyboard and the first frames of a cold start. Leaving the landscape
	  entries in while Dart asked for portrait meant the two disagreed for
	  exactly as long as the engine took to boot, which is the window a
	  rotation flash lives in.

	  The ~ipad key is a separate list, not an addition to the one above, and
	  it is the one that is easy to miss: with only the iPhone key trimmed, an
	  iPad goes on rotating freely no matter what the app asks for. Both are
	  trimmed to the same single value, and PortraitUpsideDown is gone from it
	  — turning the app 180° is a rotation like any other.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
